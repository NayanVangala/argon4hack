# Configure these in your host's Secrets settings. Never commit actual values.
GEMINI_API_KEY=
# Generate a long random token for remote access. Required unless loopback-only mode is explicitly enabled.
SCENE_API_TOKEN=
# One server instance and one worker only; mount persistent storage here in production.
SCENE_DB_PATH=/data/scene.sqlite3
# Comma-separated exact frontend origins. Same-origin browser UI does not need CORS.
SCENE_CORS_ORIGINS=
# Local laptop demo only, bind to 127.0.0.1. NEVER enable on a public service.
SCENE_ALLOW_LOCAL_NO_AUTH=0
